# Copy this to a private .env file, or set these as PRIVATE host variables.
# The old Discord token shared in chat MUST be reset. Never commit the replacement.
DISCORD_TOKEN=replace_with_NEW_rotated_bot_token
GUILD_ID=1559829257952174192
OWNER_ID=1500253920918900883

# This public Account ID is from your existing Verify Portal Cloudflare configuration.
# Workers AI still REQUIRES your private API token from Cloudflare.
CLOUDFLARE_ACCOUNT_ID=c7bafe49da51ae92601521edbd5bc2f7
CLOUDFLARE_API_TOKEN=
# High-volume, low-cost default. Change to @cf/meta/llama-3.2-3b-instruct for higher answer quality.
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-1b-instruct

TICKET_CATEGORY_ID=0
DB_PATH=bot.sqlite3
